Name "@CLIENT_NAME@"
OutFile "@abs_top_builddir@/Sugarchain-En-@CLIENT_VERSION_STRING@-win64-setup.exe"

RequestExecutionLevel highest
SetCompressor /SOLID lzma
SetDateSave off
Unicode true

# Uncomment these lines when investigating reproducibility errors
#SetCompress off
#SetDatablockOptimize off

# General Symbol Definitions
!define REGKEY "SOFTWARE\Sugarchain En"
!define LEGACY_REGKEY "SOFTWARE\Sugarchain Komorebi"
!define UNINSTALL_REGKEY "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sugarchain En"
!define COMPANY "@CLIENT_NAME@ project"
!define URL @CLIENT_URL@

# MUI Symbol Definitions
!define MUI_ICON "@abs_top_srcdir@/share/pixmaps/sugarchain.ico"
!define MUI_WELCOMEFINISHPAGE_BITMAP "@abs_top_srcdir@/share/pixmaps/nsis-wizard.bmp"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_RIGHT
!define MUI_HEADERIMAGE_BITMAP "@abs_top_srcdir@/share/pixmaps/nsis-header.bmp"
!define MUI_FINISHPAGE_NOAUTOCLOSE
!define MUI_STARTMENUPAGE_REGISTRY_ROOT HKCU
!define MUI_STARTMENUPAGE_REGISTRY_KEY "${REGKEY}"
!define MUI_STARTMENUPAGE_REGISTRY_VALUENAME StartMenuGroup
!define MUI_STARTMENUPAGE_DEFAULTFOLDER "@CLIENT_NAME@"
!define MUI_FINISHPAGE_RUN "$WINDIR\explorer.exe"
!define MUI_FINISHPAGE_RUN_PARAMETERS $INSTDIR\@BITCOIN_GUI_NAME@@EXEEXT@
!define MUI_UNICON "${NSISDIR}\Contrib\Graphics\Icons\modern-uninstall.ico"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "@abs_top_srcdir@/share/pixmaps/nsis-wizard.bmp"
!define MUI_UNFINISHPAGE_NOAUTOCLOSE

# Included files
!include Sections.nsh
!include MUI2.nsh
!include x64.nsh

# Variables
Var StartMenuGroup
Var LegacyInstallDir
Var LegacyStartMenuGroup
Var LegacyRegKey
Var LegacyProductName

# Installer pages
!insertmacro MUI_PAGE_WELCOME
!define MUI_PAGE_CUSTOMFUNCTION_LEAVE CheckInstallDirectory
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_STARTMENU Application $StartMenuGroup
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

# Installer languages
!insertmacro MUI_LANGUAGE English

# Installer attributes
InstallDir "$PROGRAMFILES64\Sugarchain En"
CRCCheck force
XPStyle on
BrandingText " "
ShowInstDetails show
VIProductVersion @CLIENT_VERSION_MAJOR@.@CLIENT_VERSION_MINOR@.@CLIENT_VERSION_BUILD@.0
VIAddVersionKey ProductName "@CLIENT_NAME@"
VIAddVersionKey ProductVersion "@CLIENT_VERSION_STRING@"
VIAddVersionKey CompanyName "${COMPANY}"
VIAddVersionKey CompanyWebsite "${URL}"
VIAddVersionKey FileVersion "@CLIENT_VERSION_STRING@"
VIAddVersionKey FileDescription "Installer for @CLIENT_NAME@"
VIAddVersionKey LegalCopyright "Copyright (C) 2009-@COPYRIGHT_YEAR@ @COPYRIGHT_HOLDERS_FINAL@"
InstallDirRegKey HKCU "${REGKEY}" Path
ShowUninstDetails show

# Installer sections
Section -Main SEC0000
    # Also check silent installs, which do not visit the directory page.
    Call CheckInstallDirectory
    SetOutPath $INSTDIR
    SetOverwrite on
    File @abs_top_builddir@/release/@BITCOIN_GUI_NAME@@EXEEXT@
    File @abs_top_builddir@/release/@BITCOIN_WRAPPER_NAME@@EXEEXT@
    File /oname=COPYING.txt @abs_top_srcdir@/COPYING
    File /oname=readme.txt @abs_top_srcdir@/doc/README_windows.txt
    # Keep an existing installation's local configuration unchanged.
    SetOverwrite off
    File @abs_top_srcdir@/share/examples/sugarchain.conf
    SetOverwrite on
    SetOutPath $INSTDIR\share\rpcauth
    File @abs_top_srcdir@/share/rpcauth/*.*
    SetOutPath $INSTDIR\daemon
    File @abs_top_builddir@/release/@BITCOIN_DAEMON_NAME@@EXEEXT@
    File @abs_top_builddir@/release/@BITCOIN_CLI_NAME@@EXEEXT@
    File @abs_top_builddir@/release/@BITCOIN_TX_NAME@@EXEEXT@
    File @abs_top_builddir@/release/@BITCOIN_WALLET_TOOL_NAME@@EXEEXT@
    File @abs_top_builddir@/release/@BITCOIN_UTIL_NAME@@EXEEXT@
    SetOutPath $INSTDIR
    WriteRegStr HKCU "${REGKEY}\Components" Main 1
SectionEnd

Section -post SEC0001
    WriteRegStr HKCU "${REGKEY}" Path $INSTDIR
    SetOutPath $INSTDIR
    ClearErrors
    WriteUninstaller $INSTDIR\uninstall.exe
    IfErrors 0 +3
        MessageBox MB_OK|MB_ICONSTOP "Could not write the Sugarchain En uninstaller. Existing registration has been retained." /SD IDOK
        Abort
    !insertmacro MUI_STARTMENU_WRITE_BEGIN Application
    CreateDirectory $SMPROGRAMS\$StartMenuGroup
    CreateShortcut "$SMPROGRAMS\$StartMenuGroup\$(^Name).lnk" $INSTDIR\@BITCOIN_GUI_NAME@@EXEEXT@
    # Remove launchers from older En installations for unsupported chains.
    Delete "$SMPROGRAMS\$StartMenuGroup\@CLIENT_NAME@ (testnet).lnk"
    Delete "$SMPROGRAMS\$StartMenuGroup\@CLIENT_NAME@ (test signet).lnk"
    Delete "$SMPROGRAMS\$StartMenuGroup\@CLIENT_NAME@ (testnet4).lnk"
    CreateShortcut "$SMPROGRAMS\$StartMenuGroup\Uninstall $(^Name).lnk" $INSTDIR\uninstall.exe
    !insertmacro MUI_STARTMENU_WRITE_END
    WriteRegStr HKCU "${UNINSTALL_REGKEY}" DisplayName "$(^Name)"
    WriteRegStr HKCU "${UNINSTALL_REGKEY}" DisplayVersion "@CLIENT_VERSION_STRING@"
    WriteRegStr HKCU "${UNINSTALL_REGKEY}" Publisher "${COMPANY}"
    WriteRegStr HKCU "${UNINSTALL_REGKEY}" URLInfoAbout "${URL}"
    WriteRegStr HKCU "${UNINSTALL_REGKEY}" DisplayIcon '"$INSTDIR\@BITCOIN_GUI_NAME@@EXEEXT@"'
    WriteRegStr HKCU "${UNINSTALL_REGKEY}" UninstallString '"$INSTDIR\uninstall.exe"'
    WriteRegDWORD HKCU "${UNINSTALL_REGKEY}" NoModify 1
    WriteRegDWORD HKCU "${UNINSTALL_REGKEY}" NoRepair 1
    WriteRegStr HKCR "@CLIENT_TARNAME@" "URL Protocol" ""
    WriteRegStr HKCR "@CLIENT_TARNAME@" "" "URL:Sugarchain"
    WriteRegStr HKCR "@CLIENT_TARNAME@\DefaultIcon" "" $INSTDIR\@BITCOIN_GUI_NAME@@EXEEXT@
    WriteRegStr HKCR "@CLIENT_TARNAME@\shell\open\command" "" '"$INSTDIR\@BITCOIN_GUI_NAME@@EXEEXT@" "%1"'

    # Retire only the legacy installation upgraded in place. Its uninstaller
    # has been replaced; never delete another product's installation tree.
    ${If} $LegacyInstallDir != ""
    ${AndIf} $LegacyInstallDir == $INSTDIR
        DeleteRegKey HKCU "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$LegacyProductName"
        DeleteRegValue HKCU "$LegacyRegKey\Components" Main
        DeleteRegValue HKCU "$LegacyRegKey" StartMenuGroup
        DeleteRegValue HKCU "$LegacyRegKey" Path
        DeleteRegKey /IfEmpty HKCU "$LegacyRegKey\Components"
        DeleteRegKey /IfEmpty HKCU "$LegacyRegKey"
        ${If} $LegacyStartMenuGroup != ""
            Delete "$SMPROGRAMS\$LegacyStartMenuGroup\Sugarchain Komorebi.lnk"
            Delete "$SMPROGRAMS\$LegacyStartMenuGroup\Sugarchain Komorebi (testnet).lnk"
            Delete "$SMPROGRAMS\$LegacyStartMenuGroup\Sugarchain Komorebi (testnet4).lnk"
            Delete "$SMPROGRAMS\$LegacyStartMenuGroup\Sugarchain Komorebi (test signet).lnk"
            Delete "$SMPROGRAMS\$LegacyStartMenuGroup\Uninstall Sugarchain Komorebi.lnk"
            Delete "$SMPROGRAMS\$LegacyStartMenuGroup\Sugarchain Komorebi (64-bit).lnk"
            Delete "$SMPROGRAMS\$LegacyStartMenuGroup\Uninstall Sugarchain Komorebi (64-bit).lnk"
            Delete "$SMPROGRAMS\$LegacyStartMenuGroup\Sugarchain Komorebi (testnet, 64-bit).lnk"
            RMDir "$SMPROGRAMS\$LegacyStartMenuGroup"
        ${EndIf}
    ${EndIf}
SectionEnd

# Macro for selecting uninstaller sections
!macro SELECT_UNSECTION SECTION_NAME UNSECTION_ID
    Push $R0
    ReadRegStr $R0 HKCU "${REGKEY}\Components" "${SECTION_NAME}"
    StrCmp $R0 1 0 next${UNSECTION_ID}
    !insertmacro SelectSection "${UNSECTION_ID}"
    GoTo done${UNSECTION_ID}
next${UNSECTION_ID}:
    !insertmacro UnselectSection "${UNSECTION_ID}"
done${UNSECTION_ID}:
    Pop $R0
!macroend

# Uninstaller sections
Section /o -un.Main UNSEC0000
    Delete /REBOOTOK $INSTDIR\@BITCOIN_WRAPPER_NAME@@EXEEXT@
    Delete /REBOOTOK $INSTDIR\@BITCOIN_GUI_NAME@@EXEEXT@
    Delete /REBOOTOK $INSTDIR\COPYING.txt
    Delete /REBOOTOK $INSTDIR\readme.txt
    # Leave configuration and extra user files untouched. Never recursively
    # delete directories: remove only files supplied by this package.
    Delete /REBOOTOK $INSTDIR\share\rpcauth\rpcauth.py
    Delete /REBOOTOK $INSTDIR\share\rpcauth\README.md
    RMDir /REBOOTOK $INSTDIR\share\rpcauth
    RMDir /REBOOTOK $INSTDIR\share
    Delete /REBOOTOK $INSTDIR\daemon\@BITCOIN_DAEMON_NAME@@EXEEXT@
    Delete /REBOOTOK $INSTDIR\daemon\@BITCOIN_CLI_NAME@@EXEEXT@
    Delete /REBOOTOK $INSTDIR\daemon\@BITCOIN_TX_NAME@@EXEEXT@
    Delete /REBOOTOK $INSTDIR\daemon\@BITCOIN_WALLET_TOOL_NAME@@EXEEXT@
    Delete /REBOOTOK $INSTDIR\daemon\@BITCOIN_UTIL_NAME@@EXEEXT@
    RMDir /REBOOTOK $INSTDIR\daemon
    DeleteRegValue HKCU "${REGKEY}\Components" Main
SectionEnd

Section -un.post UNSEC0001
    DeleteRegKey HKCU "${UNINSTALL_REGKEY}"
    Delete /REBOOTOK "$SMPROGRAMS\$StartMenuGroup\Uninstall $(^Name).lnk"
    Delete /REBOOTOK "$SMPROGRAMS\$StartMenuGroup\$(^Name).lnk"
    Delete /REBOOTOK "$SMPROGRAMS\$StartMenuGroup\@CLIENT_NAME@ (testnet).lnk"
    Delete /REBOOTOK "$SMPROGRAMS\$StartMenuGroup\@CLIENT_NAME@ (testnet4).lnk"
    Delete /REBOOTOK "$SMPROGRAMS\$StartMenuGroup\@CLIENT_NAME@ (test signet).lnk"
    Delete /REBOOTOK $INSTDIR\uninstall.exe
    DeleteRegValue HKCU "${REGKEY}" StartMenuGroup
    DeleteRegValue HKCU "${REGKEY}" Path
    DeleteRegKey /IfEmpty HKCU "${REGKEY}\Components"
    DeleteRegKey /IfEmpty HKCU "${REGKEY}"
    # Do not unregister another installation's payment URI handler.
    ReadRegStr $R0 HKCR "@CLIENT_TARNAME@\shell\open\command" ""
    ${If} $R0 == '"$INSTDIR\@BITCOIN_GUI_NAME@@EXEEXT@" "%1"'
        DeleteRegKey HKCR "@CLIENT_TARNAME@"
    ${EndIf}
    RmDir /REBOOTOK $SMPROGRAMS\$StartMenuGroup
    RmDir /REBOOTOK $INSTDIR
    Push $R0
    StrCpy $R0 $StartMenuGroup 1
    StrCmp $R0 ">" no_smgroup
no_smgroup:
    Pop $R0
SectionEnd

# Installer functions
Function .onInit
    InitPluginsDir
    ${If} ${RunningX64}
      ; disable registry redirection (enable access to 64-bit portion of registry)
      SetRegView 64
    ${Else}
      MessageBox MB_OK|MB_ICONSTOP "Cannot install 64-bit version on a 32-bit system." /SD IDOK
      Abort
    ${EndIf}
    # InstallDirRegKey is evaluated before the explicit 64-bit registry view.
    ReadRegStr $R1 HKCU "${REGKEY}" Path
    ${If} $R1 != ""
        StrCpy $INSTDIR $R1
    ${EndIf}
    StrCpy $LegacyProductName "Sugarchain Komorebi"
    StrCpy $LegacyRegKey "${LEGACY_REGKEY}"
    ReadRegStr $LegacyInstallDir HKCU "$LegacyRegKey" Path
    ${If} $LegacyInstallDir == ""
        StrCpy $LegacyProductName "Sugarchain Komorebi (64-bit)"
        StrCpy $LegacyRegKey "${LEGACY_REGKEY} (64-bit)"
        ReadRegStr $LegacyInstallDir HKCU "$LegacyRegKey" Path
    ${EndIf}
    ${If} $LegacyInstallDir != ""
        GetFullPathName $LegacyInstallDir $LegacyInstallDir
        StrCmp $LegacyInstallDir "" invalid_legacy
        ${If} $R1 != ""
        ${AndIf} $R1 != $LegacyInstallDir
            MessageBox MB_OK|MB_ICONSTOP "Separate Sugarchain En and Komorebi installations are registered. Uninstall the old product normally before upgrading En. No files have been changed." /SD IDOK
            Abort
        ${EndIf}
        IfFileExists "$LegacyInstallDir\uninstall.exe" 0 invalid_legacy
        IfFileExists "$LegacyInstallDir\@BITCOIN_GUI_NAME@@EXEEXT@" 0 invalid_legacy
        ReadRegStr $LegacyStartMenuGroup HKCU "$LegacyRegKey" StartMenuGroup
        # Older installers stored the menu group in HKLM instead of HKCU.
        ${If} $LegacyStartMenuGroup == ""
            ReadRegStr $LegacyStartMenuGroup HKLM "$LegacyRegKey" StartMenuGroup
        ${EndIf}
        StrCpy $INSTDIR $LegacyInstallDir
        IfSilent done
        MessageBox MB_OK|MB_ICONINFORMATION "Sugarchain Komorebi will be upgraded to Sugarchain En in its existing installation folder. Wallets, chain data and settings are preserved. To choose a new folder, first uninstall the old application normally."
    ${EndIf}
    Goto done
invalid_legacy:
    MessageBox MB_OK|MB_ICONSTOP "The registered Sugarchain Komorebi installation is incomplete. Repair or uninstall it normally before installing Sugarchain En. No files have been changed." /SD IDOK
    Abort
done:
FunctionEnd

Function CheckInstallDirectory
    # GetFullPathName returns an empty string for a directory that does not
    # exist yet. SetOutPath will create it on a fresh install.
    GetFullPathName $0 $INSTDIR
    ${If} $0 != ""
        StrCpy $INSTDIR $0
    ${Else}
        ClearErrors
    ${EndIf}
    ${If} $LegacyInstallDir != ""
    ${AndIf} $LegacyInstallDir != $0
        MessageBox MB_OK|MB_ICONSTOP "Upgrade Sugarchain Komorebi in its existing folder, or uninstall it normally before selecting a new folder." /SD IDOK
        Abort
    ${EndIf}
FunctionEnd

# Uninstaller functions
Function un.onInit
    SetRegView 64
    # Bind the uninstaller to its own installation, not a stale registry path.
    ReadRegStr $R0 HKCU "${REGKEY}" Path
    ${If} $R0 != $INSTDIR
        MessageBox MB_OK|MB_ICONSTOP "This uninstaller no longer matches the registered Sugarchain En installation. No files have been removed." /SD IDOK
        Abort
    ${EndIf}
    !insertmacro MUI_STARTMENU_GETFOLDER Application $StartMenuGroup
    !insertmacro SELECT_UNSECTION Main ${UNSEC0000}
FunctionEnd
